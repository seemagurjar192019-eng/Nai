# GEMINI_API_KEY: Server-only API key for voice parsing and receipt OCR.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_APP_URL: The canonical URL where this applet is hosted.
# Used for metadataBase, sitemap, OpenGraph tags, and TWA deep links.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"
