{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Shopkeeper profile, onboarding state, theme, language, and security preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mobileNumber": { "type": "string", "minLength": 0, "maxLength": 20 },
        "language": {
          "type": "string",
          "enum": ["en", "hi", "hinglish", "mr", "gu", "ta", "te", "pa", "ml", "kn", "bn"]
        },
        "appearance": { "type": "string", "enum": ["light", "dark"] },
        "activeBusinessId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "appLockPin": { "type": "string", "minLength": 0, "maxLength": 128 },
        "onboardingDone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "mobileNumber", "language", "appearance", "activeBusinessId", "onboardingDone", "createdAt", "updatedAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Shop or business profile with GST, business card details, and UPI VPA.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 20 },
        "gstNumber": { "type": "string", "minLength": 0, "maxLength": 24 },
        "businessType": { "type": "string", "minLength": 0, "maxLength": 60 },
        "category": { "type": "string", "minLength": 0, "maxLength": 60 },
        "address": { "type": "string", "minLength": 0, "maxLength": 240 },
        "email": { "type": "string", "minLength": 0, "maxLength": 120 },
        "about": { "type": "string", "minLength": 0, "maxLength": 300 },
        "upiId": { "type": "string", "minLength": 0, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "phone", "gstNumber", "businessType", "category", "address", "email", "about", "upiId", "createdAt", "updatedAt"]
    },
    "LedgerAccount": {
      "title": "LedgerAccount",
      "description": "Customer or supplier khata account belonging to a business, including promise-to-pay tracking.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kind": { "type": "string", "enum": ["customer", "supplier"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 20 },
        "dueDate": { "type": "string", "minLength": 0, "maxLength": 24 },
        "creditLimit": { "type": "number" },
        "promiseDate": { "type": "string", "minLength": 0, "maxLength": 24 },
        "promiseNote": { "type": "string", "minLength": 0, "maxLength": 160 },
        "balance": { "type": "number" },
        "lastNote": { "type": "string", "minLength": 0, "maxLength": 160 },
        "lastActivityAt": { "type": "string", "minLength": 0, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "kind", "name", "phone", "dueDate", "balance", "lastNote", "lastActivityAt", "createdAt", "updatedAt"]
    },
    "LedgerTransaction": {
      "title": "LedgerTransaction",
      "description": "Individual credit (given) or debit (received) entry in an account ledger.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "accountId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "direction": { "type": "string", "enum": ["given", "received"] },
        "amount": { "type": "number" },
        "note": { "type": "string", "minLength": 0, "maxLength": 240 },
        "billDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "voiceRaw": { "type": "string", "minLength": 0, "maxLength": 300 },
        "billImage": { "type": "string", "minLength": 0, "maxLength": 150000 },
        "createdByName": { "type": "string", "minLength": 0, "maxLength": 80 },
        "createdByRole": { "type": "string", "enum": ["owner", "munim", "cashier"] },
        "gallaSynced": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "accountId", "direction", "amount", "note", "billDate", "voiceRaw", "billImage", "createdAt", "updatedAt"]
    },
    "BillDocument": {
      "title": "BillDocument",
      "description": "Customer bill or quote with line items, GST calculation, and estimated margin cost.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "docType": { "type": "string", "enum": ["bill", "quote"] },
        "billNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 0, "maxLength": 20 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "totalGst": { "type": "number" },
        "discountAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "unpaid", "partial"] },
        "linkedTxId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 0, "maxLength": 80 },
        "estimatedCost": { "type": "number" },
        "templateId": { "type": "string", "enum": ["classic", "modern", "gst-color", "thermal-58"] },
        "notes": { "type": "string", "minLength": 0, "maxLength": 240 },
        "billDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "docType", "billNumber", "customerName", "customerPhone", "items", "subtotal", "totalGst", "totalAmount", "templateId", "notes", "billDate", "createdAt", "updatedAt"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Shop inventory product item with unit price and stock quantity.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 24 },
        "salePrice": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "quantity": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "name", "unit", "salePrice", "quantity", "lowStockThreshold", "createdAt", "updatedAt"]
    },
    "CashbookEntry": {
      "title": "CashbookEntry",
      "description": "Live Galla cash drawer and UPI/bank inflow or outflow entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entryType": { "type": "string", "enum": ["inflow", "outflow"] },
        "mode": { "type": "string", "enum": ["cash", "upi", "bank"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "amount": { "type": "number" },
        "note": { "type": "string", "minLength": 0, "maxLength": 200 },
        "entryDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "linkedRefId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 0, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "entryType", "mode", "category", "amount", "note", "entryDate", "createdAt", "updatedAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Counter operator or Munim profile with role and optional 4-digit PIN hash.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["owner", "munim", "cashier"] },
        "phone": { "type": "string", "minLength": 0, "maxLength": 20 },
        "pinHash": { "type": "string", "minLength": 0, "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "name", "role", "phone", "active", "createdAt", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Chronological staff counter audit trail for khata, bills, stock, and Galla changes.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "businessId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "actorRole": { "type": "string", "enum": ["owner", "munim", "cashier"] },
        "actionType": { "type": "string", "enum": ["ledger", "bill", "stock", "galla", "staff", "account"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "targetName": { "type": "string", "minLength": 0, "maxLength": 100 },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "businessId", "actorName", "actorRole", "actionType", "summary", "targetName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile, theme, language, and PIN settings."
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Businesses owned by an authenticated user."
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/LedgerAccount" },
      "description": "Customer and supplier accounts linked to an owner and business."
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/LedgerTransaction" },
      "description": "Ledger transactions linked to an owner, business, and account."
    },
    "/bills/{billId}": {
      "schema": { "$ref": "#/entities/BillDocument" },
      "description": "Bills and quotes created by a business owner."
    },
    "/stockItems/{itemId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Inventory items managed by a business owner."
    },
    "/cashbookEntries/{entryId}": {
      "schema": { "$ref": "#/entities/CashbookEntry" },
      "description": "Live Galla Cashbook entries belonging to a business owner."
    },
    "/staffMembers/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Counter staff and Munim operator profiles belonging to a business owner."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Counter activity audit history belonging to a business owner."
    }
  }
}
