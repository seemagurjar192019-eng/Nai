rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.phone_number != null || request.auth.token.email_verified == true);
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isValidLanguage(lang) {
      return lang in ['en', 'hi', 'hinglish', 'mr', 'gu', 'ta', 'te', 'pa', 'ml', 'kn', 'bn'];
    }

    function isValidAppearance(mode) {
      return mode in ['light', 'dark'];
    }

    function isValidStaffRole(role) {
      return role in ['owner', 'munim', 'cashier'];
    }

    function isValidPersonaContext(ctx) {
      return ctx in ['personal', 'kirana', 'mandi', 'wholesale'];
    }

    // Entity Validation Blueprints (sized cleanly for AES-256-GCM E2EE envelopes)
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'mobileNumber', 'language', 'appearance', 'activeBusinessId', 'onboardingDone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'mobileNumber', 'language', 'appearance', 'activeBusinessId', 'appLockPin', 'onboardingDone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.mobileNumber is string && data.mobileNumber.size() <= 20
        && data.language is string && isValidLanguage(data.language)
        && data.appearance is string && isValidAppearance(data.appearance)
        && data.activeBusinessId is string && data.activeBusinessId.size() <= 128
        && (!('appLockPin' in data) || (data.appLockPin is string && data.appLockPin.size() <= 128))
        && data.onboardingDone is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVaultKeyEnvelope(data, uid) {
      return data.keys().hasAll(['ownerId', 'version', 'mode', 'wrappedDek', 'iv', 'salt', 'iterations', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'version', 'mode', 'wrappedDek', 'iv', 'salt', 'iterations', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == uid && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.version is int && data.version == 1
        && data.mode is string && data.mode in ['auto', 'pin']
        && data.wrappedDek is string && data.wrappedDek.size() >= 16 && data.wrappedDek.size() <= 512
        && data.iv is string && data.iv.size() >= 8 && data.iv.size() <= 128
        && data.salt is string && data.salt.size() >= 8 && data.salt.size() <= 128
        && data.iterations is int && data.iterations >= 10000 && data.iterations <= 600000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['ownerId', 'name', 'phone', 'gstNumber', 'businessType', 'category', 'address', 'email', 'about', 'upiId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'phone', 'gstNumber', 'businessType', 'category', 'address', 'email', 'about', 'upiId', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 512
        && data.phone is string && data.phone.size() <= 256
        && data.gstNumber is string && data.gstNumber.size() <= 256
        && data.businessType is string && data.businessType.size() <= 256
        && data.category is string && data.category.size() <= 256
        && data.address is string && data.address.size() <= 1024
        && data.email is string && data.email.size() <= 512
        && data.about is string && data.about.size() <= 1024
        && data.upiId is string && data.upiId.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLedgerAccount(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'kind', 'name', 'phone', 'dueDate', 'balance', 'lastNote', 'lastActivityAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'kind', 'name', 'phone', 'dueDate', 'creditLimit', 'promiseDate', 'promiseNote', 'balance', 'lastNote', 'lastActivityAt', 'personaContext', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && data.kind in ['customer', 'supplier']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 512
        && data.phone is string && data.phone.size() <= 256
        && data.dueDate is string && data.dueDate.size() <= 32
        && (!('creditLimit' in data) || ((data.creditLimit is int || data.creditLimit is float) && data.creditLimit >= 0 && data.creditLimit <= 100000000))
        && (!('promiseDate' in data) || (data.promiseDate is string && data.promiseDate.size() <= 32))
        && (!('promiseNote' in data) || (data.promiseNote is string && data.promiseNote.size() <= 512))
        && (data.balance is int || data.balance is float)
        && data.lastNote is string && data.lastNote.size() <= 512
        && data.lastActivityAt is string && data.lastActivityAt.size() <= 48
        && (!('personaContext' in data) || (data.personaContext is string && isValidPersonaContext(data.personaContext)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLedgerTransaction(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'accountId', 'direction', 'amount', 'note', 'billDate', 'voiceRaw', 'billImage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'accountId', 'direction', 'amount', 'note', 'billDate', 'voiceRaw', 'billImage', 'createdByName', 'createdByRole', 'gallaSynced', 'personaContext', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && isValidId(data.accountId)
        && data.direction in ['given', 'received']
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 100000000
        && data.note is string && data.note.size() <= 1024
        && data.billDate is string && data.billDate.size() >= 1 && data.billDate.size() <= 48
        && data.voiceRaw is string && data.voiceRaw.size() <= 1024
        && data.billImage is string && data.billImage.size() <= 350000
        && (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 256))
        && (!('createdByRole' in data) || (data.createdByRole is string && isValidStaffRole(data.createdByRole)))
        && (!('gallaSynced' in data) || data.gallaSynced is bool)
        && (!('personaContext' in data) || (data.personaContext is string && isValidPersonaContext(data.personaContext)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBillDocument(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'docType', 'billNumber', 'customerName', 'customerPhone', 'items', 'subtotal', 'totalGst', 'totalAmount', 'templateId', 'notes', 'billDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'docType', 'billNumber', 'customerName', 'customerPhone', 'items', 'subtotal', 'totalGst', 'discountAmount', 'totalAmount', 'paymentStatus', 'linkedTxId', 'createdByName', 'estimatedCost', 'templateId', 'notes', 'billDate', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && data.docType in ['bill', 'quote']
        && data.billNumber is string && data.billNumber.size() >= 1 && data.billNumber.size() <= 64
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 512
        && data.customerPhone is string && data.customerPhone.size() <= 256
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.items[0] is map
        && data.items[0].name is string && data.items[0].name.size() >= 1 && data.items[0].name.size() <= 256
        && (data.subtotal is int || data.subtotal is float) && data.subtotal >= 0
        && (data.totalGst is int || data.totalGst is float) && data.totalGst >= 0
        && (!('discountAmount' in data) || ((data.discountAmount is int || data.discountAmount is float) && data.discountAmount >= 0 && data.discountAmount <= 100000000))
        && (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0
        && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['paid', 'unpaid', 'partial']))
        && (!('linkedTxId' in data) || (data.linkedTxId is string && data.linkedTxId.size() <= 128))
        && (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 256))
        && (!('estimatedCost' in data) || ((data.estimatedCost is int || data.estimatedCost is float) && data.estimatedCost >= 0 && data.estimatedCost <= 100000000))
        && data.templateId in ['classic', 'modern', 'gst-color', 'thermal-58']
        && data.notes is string && data.notes.size() <= 1024
        && data.billDate is string && data.billDate.size() >= 1 && data.billDate.size() <= 48
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStockItem(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'name', 'unit', 'salePrice', 'quantity', 'lowStockThreshold', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'name', 'unit', 'salePrice', 'purchasePrice', 'quantity', 'lowStockThreshold', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 512
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 128
        && (data.salePrice is int || data.salePrice is float) && data.salePrice >= 0
        && (!('purchasePrice' in data) || ((data.purchasePrice is int || data.purchasePrice is float) && data.purchasePrice >= 0 && data.purchasePrice <= 100000000))
        && (data.quantity is int || data.quantity is float) && data.quantity >= 0
        && (data.lowStockThreshold is int || data.lowStockThreshold is float) && data.lowStockThreshold >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCashbookEntry(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'entryType', 'mode', 'category', 'amount', 'note', 'entryDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'entryType', 'mode', 'category', 'amount', 'note', 'entryDate', 'linkedRefId', 'actorName', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && data.entryType in ['inflow', 'outflow']
        && data.mode in ['cash', 'upi', 'bank']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 256
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 100000000
        && data.note is string && data.note.size() <= 1024
        && data.entryDate is string && data.entryDate.size() >= 1 && data.entryDate.size() <= 48
        && (!('linkedRefId' in data) || (data.linkedRefId is string && data.linkedRefId.size() <= 128))
        && (!('actorName' in data) || (data.actorName is string && data.actorName.size() <= 256))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'name', 'role', 'phone', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'name', 'role', 'phone', 'pinHash', 'active', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 256
        && data.role is string && isValidStaffRole(data.role)
        && data.phone is string && data.phone.size() <= 256
        && (!('pinHash' in data) || (data.pinHash is string && data.pinHash.size() <= 128))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['ownerId', 'businessId', 'actorName', 'actorRole', 'actionType', 'summary', 'targetName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'actorName', 'actorRole', 'actionType', 'summary', 'targetName', 'amount', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128
        && isValidId(data.businessId)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 256
        && data.actorRole is string && isValidStaffRole(data.actorRole)
        && data.actionType in ['ledger', 'bill', 'stock', 'galla', 'staff', 'account']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1024
        && data.targetName is string && data.targetName.size() <= 512
        && (!('amount' in data) || ((data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 100000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 3. Collection Rules

    // Connectivity probe doc check (no sensitive data)
    match /test/connection {
      allow get: if isSignedIn();
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && (!('uid' in existing()) || incoming().uid == existing().uid)
        && ((!('createdAt' in existing()) && incoming().createdAt == request.time) || (existing().createdAt is timestamp && incoming().createdAt == existing().createdAt))
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'mobileNumber', 'language', 'appearance', 'activeBusinessId', 'appLockPin', 'onboardingDone', 'createdAt', 'updatedAt', 'accentTheme', 'email', 'displayName', 'photoURL', 'name']);
      allow delete: if isValidId(uid) && isOwner(uid);

      match /security/{docId} {
        allow get, list: if isValidId(uid) && isOwner(uid);
        allow create: if isValidId(uid)
          && isValidId(docId)
          && isOwner(uid)
          && isValidVaultKeyEnvelope(incoming(), uid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(uid)
          && isValidId(docId)
          && isOwner(uid)
          && isValidVaultKeyEnvelope(incoming(), uid)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['version', 'mode', 'wrappedDek', 'iv', 'salt', 'iterations', 'updatedAt']);
        allow delete: if isValidId(uid) && isValidId(docId) && isOwner(uid);
      }
    }

    match /businesses/{businessId} {
      allow get: if isValidId(businessId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(businessId)
        && isVerified()
        && isValidBusiness(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(businessId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidBusiness(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'gstNumber', 'businessType', 'category', 'address', 'email', 'about', 'upiId', 'updatedAt']);
      allow delete: if isValidId(businessId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /accounts/{accountId} {
      allow get: if isValidId(accountId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(accountId)
        && isVerified()
        && isValidLedgerAccount(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId))
        && getAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(accountId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidLedgerAccount(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().businessId == existing().businessId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['kind', 'name', 'phone', 'dueDate', 'creditLimit', 'promiseDate', 'promiseNote', 'balance', 'lastNote', 'lastActivityAt', 'personaContext', 'updatedAt']);
      allow delete: if isValidId(accountId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /transactions/{txId} {
      allow get: if isValidId(txId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(txId)
        && isVerified()
        && isValidLedgerTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/accounts/$(incoming().accountId))
        && getAfter(/databases/$(database)/documents/accounts/$(incoming().accountId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/accounts/$(incoming().accountId)).data.businessId == incoming().businessId;
      allow update: if isValidId(txId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidLedgerTransaction(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().businessId == existing().businessId
        && incoming().accountId == existing().accountId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['direction', 'amount', 'note', 'billDate', 'voiceRaw', 'billImage', 'createdByName', 'createdByRole', 'gallaSynced', 'personaContext', 'updatedAt']);
      allow delete: if isValidId(txId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /bills/{billId} {
      allow get: if isValidId(billId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(billId)
        && isVerified()
        && isValidBillDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId))
        && getAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(billId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidBillDocument(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().businessId == existing().businessId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['docType', 'billNumber', 'customerName', 'customerPhone', 'items', 'subtotal', 'totalGst', 'discountAmount', 'totalAmount', 'paymentStatus', 'linkedTxId', 'createdByName', 'estimatedCost', 'templateId', 'notes', 'billDate', 'updatedAt']);
      allow delete: if isValidId(billId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /stockItems/{itemId} {
      allow get: if isValidId(itemId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(itemId)
        && isVerified()
        && isValidStockItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId))
        && getAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(itemId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidStockItem(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().businessId == existing().businessId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'unit', 'salePrice', 'purchasePrice', 'quantity', 'lowStockThreshold', 'updatedAt']);
      allow delete: if isValidId(itemId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /cashbookEntries/{entryId} {
      allow get: if isValidId(entryId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(entryId)
        && isVerified()
        && isValidCashbookEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId))
        && getAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(entryId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidCashbookEntry(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().businessId == existing().businessId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['entryType', 'mode', 'category', 'amount', 'note', 'entryDate', 'linkedRefId', 'actorName', 'updatedAt']);
      allow delete: if isValidId(entryId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /staffMembers/{staffId} {
      allow get: if isValidId(staffId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(staffId)
        && isVerified()
        && isValidStaffMember(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId))
        && getAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(staffId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && isValidStaffMember(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().businessId == existing().businessId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'phone', 'pinHash', 'active', 'updatedAt']);
      allow delete: if isValidId(staffId) && isVerified() && existing().ownerId == request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(logId)
        && isVerified()
        && isValidActivityLog(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/businesses/$(incoming().businessId))
        && getAfter(/databases/$(database)/documents/businesses/$(incoming().businessId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isValidId(logId) && isVerified() && existing().ownerId == request.auth.uid;
    }
  }
}
